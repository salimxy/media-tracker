# ============================================================================
# CONFIGURATION ENVIRONNEMENT - Veille Stratégique Marocaine
# ============================================================================
# IMPORTANT: Copiez ce fichier en .env et remplissez avec vos vraies valeurs
# NE COMMITTEZ JAMAIS le fichier .env dans Git!
# ============================================================================

# ============================================================================
# VPS CONFIGURATION
# ============================================================================
VPS_IP=192.168.1.100
VPS_USER=root

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_USER=veille_user
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_TRES_FORT
POSTGRES_DB=veille_maroc
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# N8N CONFIGURATION
# ============================================================================
N8N_HOST=n8n.veille-maroc.local
N8N_PORT=5678
N8N_PROTOCOL=http

# Authentification N8N (Basic Auth)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changez_moi_aussi_123

# Base de données N8N (utilise PostgreSQL)
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n
N8N_DB_POSTGRESDB_USER=veille_user
N8N_DB_POSTGRESDB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_TRES_FORT

# ============================================================================
# API BACKEND CONFIGURATION
# ============================================================================
API_HOST=backend
API_PORT=3001
NODE_ENV=production

# URLs
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ============================================================================
# OPENROUTER API (Pour l'analyse IA)
# ============================================================================
# Obtenez votre clé sur: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-VOTRE_CLE_API_ICI
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ============================================================================
# EMAIL CONFIGURATION (Pour les notifications)
# ============================================================================
# SMTP Gmail (recommandé d'utiliser un App Password)
# Créez un App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre_app_password_gmail

# Email administrateur
ADMIN_EMAIL=votre-email@gmail.com
ADMIN_NAME=Veille Maroc Admin

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:3001

# ============================================================================
# SECURITY & SECRETS
# ============================================================================
# Générez des secrets forts avec: openssl rand -base64 32
JWT_SECRET=CHANGEZ_AVEC_UNE_CLE_ALEATOIRE_FORTE
SESSION_SECRET=CHANGEZ_AVEC_UNE_AUTRE_CLE_ALEATOIRE_FORTE

# Encryption key (32 caractères)
ENCRYPTION_KEY=CHANGEZ_AVEC_32_CARACTERES_ALEATOIRES

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=Africa/Casablanca

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE=/var/log/veille-maroc.log

# ============================================================================
# REDIS (Optionnel - pour le cache)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# NGINX CONFIGURATION (Si utilisé)
# ============================================================================
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=veille.votredomaine.com

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_DIR=/opt/veille-maroc/backups
BACKUP_RETENTION_DAYS=7

# ============================================================================
# MONITORING (Optionnel)
# ============================================================================
SENTRY_DSN=
NEWRELIC_LICENSE_KEY=

# ============================================================================
# NOTES
# ============================================================================
# 1. Changez TOUS les mots de passe avant de déployer
# 2. Utilisez des secrets forts (minimum 32 caractères aléatoires)
# 3. Pour générer un secret: openssl rand -base64 32
# 4. Ne partagez JAMAIS ce fichier une fois rempli
# 5. Ajoutez .env au .gitignore
# ============================================================================
